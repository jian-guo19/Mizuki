---
import { PageHeader } from "@components/features/page-header";
import MainGridLayout from "@layouts/MainGridLayout.astro";

const title = "工具";
const subtitle = "自己写、自己用的小工具。能直接跑的不废话，需要本地跑的给命令。";
---

<MainGridLayout title={title} description={subtitle}>
	<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-6 sm:px-9 py-6 relative w-full">
			<PageHeader title={title} subtitle={subtitle} />

			<!-- ============ 工具一：中转站体检 ============ -->
			<section id="api-check" class="mb-12">
				<h2 class="text-2xl font-bold mb-3 text-90">API 中转站体检</h2>
				<p class="text-75 mb-4 leading-relaxed">
					换中转站之前先跑一遍，比充完钱再骂划算。四项检测分别回答四个问题：
					它到底有哪些模型、思考过程会不会被吞、你的正文额度是不是在替思考付账、
					以及它有没有拿缓存糊弄你。
				</p>

				<div class="rounded-xl border border-black/10 dark:border-white/15 bg-black/[0.02] dark:bg-white/[0.03] p-4 mb-6">
					<p class="text-sm text-75 leading-relaxed">
						<strong class="text-90">为什么不能在这个页面直接跑：</strong>
						浏览器的跨域策略（CORS）会拦掉对第三方接口的请求，而绝大多数中转站不会给
						<code class="px-1 rounded bg-black/5 dark:bg-white/10">Access-Control-Allow-Origin</code>
						响应头。所以这里做的是「填参数 → 生成命令」，命令复制到本机终端执行。检测逻辑完全一样。
					</p>
				</div>

				<!-- 参数输入 -->
				<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
					<label class="flex flex-col gap-1">
						<span class="text-sm text-75">服务器地址</span>
						<input
							id="baseUrl"
							type="text"
							value="https://api.example.com/v1"
							class="px-3 py-2 rounded-lg bg-black/5 dark:bg-white/10 border border-black/10 dark:border-white/15 text-sm outline-none focus:border-[var(--primary)]"
						/>
					</label>
					<label class="flex flex-col gap-1">
						<span class="text-sm text-75">API Key</span>
						<input
							id="apiKey"
							type="text"
							value="sk-xxxxxxxx"
							class="px-3 py-2 rounded-lg bg-black/5 dark:bg-white/10 border border-black/10 dark:border-white/15 text-sm outline-none focus:border-[var(--primary)]"
						/>
					</label>
					<label class="flex flex-col gap-1">
						<span class="text-sm text-75">模型名</span>
						<input
							id="modelName"
							type="text"
							value="gpt-4o-mini"
							class="px-3 py-2 rounded-lg bg-black/5 dark:bg-white/10 border border-black/10 dark:border-white/15 text-sm outline-none focus:border-[var(--primary)]"
						/>
					</label>
				</div>

				<!-- 命令块 1 -->
				<div class="mb-6">
					<div class="flex items-center justify-between mb-2">
						<h3 class="font-semibold text-90">① 拉模型列表</h3>
						<button class="copy-btn text-xs px-3 py-1 rounded-lg bg-black/5 dark:bg-white/10 hover:bg-black/10 dark:hover:bg-white/20 transition" data-target="cmd1">
							复制
						</button>
					</div>
					<pre id="cmd1" class="p-4 rounded-xl bg-black/[0.04] dark:bg-white/[0.06] overflow-x-auto text-xs leading-relaxed"><code></code></pre>
					<p class="text-xs text-50 mt-2">
						看它返回的是什么结构。如果 18 个模型全是同一家（全 Gemini、全 Claude），说明它是套壳转卖，随时可能下架。
					</p>
				</div>

				<!-- 命令块 2 -->
				<div class="mb-6">
					<div class="flex items-center justify-between mb-2">
						<h3 class="font-semibold text-90">② 看思考字段会不会被吞</h3>
						<button class="copy-btn text-xs px-3 py-1 rounded-lg bg-black/5 dark:bg-white/10 hover:bg-black/10 dark:hover:bg-white/20 transition" data-target="cmd2">
							复制
						</button>
					</div>
					<pre id="cmd2" class="p-4 rounded-xl bg-black/[0.04] dark:bg-white/[0.06] overflow-x-auto text-xs leading-relaxed"><code></code></pre>
					<p class="text-xs text-50 mt-2">
						重点看两处：<code>message</code> 里有没有 <code>reasoning_content</code> 字段，以及
						<code>reasoning_tokens</code> 占 <code>completion_tokens</code> 的比例。有 token 但没文本，就是被吞了。
					</p>
				</div>

				<!-- 命令块 3 -->
				<div class="mb-6">
					<div class="flex items-center justify-between mb-2">
						<h3 class="font-semibold text-90">③ 完整体检脚本（四项一次跑完）</h3>
						<button class="copy-btn text-xs px-3 py-1 rounded-lg bg-black/5 dark:bg-white/10 hover:bg-black/10 dark:hover:bg-white/20 transition" data-target="cmd3">
							复制
						</button>
					</div>
					<pre id="cmd3" class="p-4 rounded-xl bg-black/[0.04] dark:bg-white/[0.06] overflow-x-auto text-xs leading-relaxed max-h-[420px] overflow-y-auto"><code></code></pre>
					<p class="text-xs text-50 mt-2">
						存成 <code>check_api.py</code>，把顶部三个变量换成你的，然后 <code>python check_api.py</code>。
					</p>
				</div>

				<!-- 判读表 -->
				<h3 class="font-semibold text-lg mt-8 mb-3 text-90">结果怎么读</h3>
				<div class="overflow-x-auto mb-4">
					<table class="w-full text-sm border-collapse">
						<thead>
							<tr class="border-b border-black/10 dark:border-white/15 text-left">
								<th class="py-2 pr-4 font-semibold text-90">现象</th>
								<th class="py-2 font-semibold text-90">说明</th>
							</tr>
						</thead>
						<tbody class="text-75">
							<tr class="border-b border-black/5 dark:border-white/10">
								<td class="py-2 pr-4 align-top">有 <code>reasoning_tokens</code>，没有 <code>reasoning_content</code></td>
								<td class="py-2">模型在思考，但思考文本被网关丢了。酒馆里永远看不到「思考了 X 秒」，客户端改参数也补不回来。</td>
							</tr>
							<tr class="border-b border-black/5 dark:border-white/10">
								<td class="py-2 pr-4 align-top">思考 token 占输出一半以上</td>
								<td class="py-2">正文额度在替思考付账。表现就是「写一点就停」，把「最大回复长度」提到 8000 以上能缓解。</td>
							</tr>
							<tr class="border-b border-black/5 dark:border-white/10">
								<td class="py-2 pr-4 align-top">同一请求两次输出完全一致</td>
								<td class="py-2">网关做了响应缓存。调温度、调惩罚全部无效，重新生成也是原样。</td>
							</tr>
							<tr class="border-b border-black/5 dark:border-white/10">
								<td class="py-2 pr-4 align-top"><code>finish_reason</code> 是 <code>length</code></td>
								<td class="py-2">被 <code>max_tokens</code> 截断，不是模型自己写完的。</td>
							</tr>
							<tr>
								<td class="py-2 pr-4 align-top">模型列表全是同一家</td>
								<td class="py-2">套壳转卖，模型随时下架（今天能用明天 404）。</td>
							</tr>
						</tbody>
					</table>
				</div>
			</section>

			<div class="border-t border-black/10 dark:border-white/15 pt-6">
				<p class="text-sm text-50">
					工具会继续加。有想要的功能可以直接在
					<a href="/about/" class="text-[var(--primary)] hover:underline">关于</a>
					页面找到联系方式告诉我。
				</p>
			</div>
		</div>
	</div>

	<script is:inline>
		(function () {
			const baseEl = document.getElementById("baseUrl");
			const keyEl = document.getElementById("apiKey");
			const modelEl = document.getElementById("modelName");

			const pyScript = [
				"# -*- coding: utf-8 -*-",
				"# API 中转站四项体检：模型列表 / 思考字段 / 响应缓存 / 长文截断",
				"import json, time, urllib.request",
				"",
				"BASE  = \"__BASE__\"",
				"KEY   = \"__KEY__\"",
				"MODEL = \"__MODEL__\"",
				"",
				"def call(path, body=None):",
				"    url = BASE.rstrip('/') + path",
				"    data = json.dumps(body).encode() if body else None",
				"    req = urllib.request.Request(url, data=data, headers={",
				"        'Authorization': 'Bearer ' + KEY,",
				"        'Content-Type': 'application/json',",
				"        'User-Agent': 'Mozilla/5.0',",
				"    })",
				"    t = time.time()",
				"    with urllib.request.urlopen(req, timeout=180) as r:",
				"        return json.loads(r.read()), time.time() - t",
				"",
				"print('① 模型列表')",
				"try:",
				"    d, _ = call('/models')",
				"    ids = [m['id'] for m in d.get('data', [])]",
				"    print('   OK，%d 个模型：%s' % (len(ids), ', '.join(ids[:12])))",
				"except Exception as e:",
				"    print('   失败:', e)",
				"",
				"PROMPT = '鸡兔同笼，共 35 只、94 只脚。各几只？请说明推理。'",
				"body = {'model': MODEL, 'messages': [{'role': 'user', 'content': PROMPT}], 'max_tokens': 1024}",
				"",
				"print()",
				"print('② 思考字段')",
				"try:",
				"    d, cost = call('/chat/completions', body)",
				"    m = d['choices'][0]['message']",
				"    think = m.get('reasoning_content') or m.get('reasoning') or ''",
				"    u = d.get('usage') or {}",
				"    det = u.get('completion_tokens_details') or {}",
				"    rt = det.get('reasoning_tokens', 0) or 0",
				"    ct = u.get('completion_tokens', 0) or 0",
				"    print('   message 字段:', list(m.keys()))",
				"    print('   可读思考: %d 字' % len(think))",
				"    print('   思考 token: %d / 总输出 %d' % (rt, ct))",
				"    if ct and rt:",
				"        print('   占比: %.0f%%' % (rt * 100.0 / ct))",
				"    if not think and rt:",
				"        print('   → 模型在思考，但网关不回传 reasoning_content')",
				"except Exception as e:",
				"    print('   失败:', e)",
				"",
				"print()",
				"print('③ 响应缓存')",
				"try:",
				"    a, _ = call('/chat/completions', body)",
				"    b, _ = call('/chat/completions', body)",
				"    ta = a['choices'][0]['message'].get('content') or ''",
				"    tb = b['choices'][0]['message'].get('content') or ''",
				"    print('   两次完全一致 → 疑似响应缓存' if ta == tb else '   两次不同 → 正常')",
				"except Exception as e:",
				"    print('   失败:', e)",
				"",
				"print()",
				"print('④ 长文输出上限')",
				"try:",
				"    d, cost = call('/chat/completions', {",
				"        'model': MODEL,",
				"        'messages': [{'role': 'user', 'content': '用中文写 2000 字科普，讲潮汐成因，别提前收尾。'}],",
				"        'max_tokens': 8192,",
				"    })",
				"    ch = d['choices'][0]",
				"    txt = ch['message'].get('content') or ''",
				"    print('   %.1fs  finish=%s  正文 %d 字' % (cost, ch.get('finish_reason'), len(txt)))",
				"    if ch.get('finish_reason') == 'length':",
				"        print('   → 被 max_tokens 截断')",
				"except Exception as e:",
				"    print('   失败:', e)",
				"",
				"print()",
				"print('体检完成。四项现象对照工具页的「结果怎么读」表格逐条判断。')",
			].join("\n");

			const shQuote = (s) => "'" + String(s).replace(/'/g, "'\\''") + "'";

			function render() {
				const base = (baseEl.value || "").trim().replace(/\/+$/, "");
				const key = (keyEl.value || "").trim();
				const model = (modelEl.value || "").trim();

				const cmd1 =
					'curl -s "' + base + '/models" \\\n' +
					'  -H "Authorization: Bearer ' + key + '" \\\n' +
					'  | python -m json.tool';

				const payload = JSON.stringify({
					model: model,
					messages: [{ role: "user", content: "鸡兔同笼，共 35 只、94 只脚。各几只？请说明推理。" }],
					max_tokens: 1024,
				});

				const cmd2 =
					'curl -s "' + base + '/chat/completions" \\\n' +
					'  -H "Authorization: Bearer ' + key + '" \\\n' +
					'  -H "Content-Type: application/json" \\\n' +
					"  -d " + shQuote(payload) + " \\\n" +
					'  | python -c "import sys,json;d=json.load(sys.stdin);m=d[\'choices\'][0][\'message\'];u=d.get(\'usage\',{});print(\'message 字段:\',list(m.keys()));print(\'可读思考:\',len(m.get(\'reasoning_content\') or \'\'));print(\'usage:\',u)"';

				const cmd3 = pyScript
					.replace("__BASE__", base)
					.replace("__KEY__", key)
					.replace("__MODEL__", model);

				const set = (id, text) => {
					const el = document.querySelector("#" + id + " code");
					if (el) el.textContent = text;
				};
				set("cmd1", cmd1);
				set("cmd2", cmd2);
				set("cmd3", cmd3);
			}

			[baseEl, keyEl, modelEl].forEach((el) => {
				if (el) el.addEventListener("input", render);
			});
			render();

			document.querySelectorAll(".copy-btn").forEach((btn) => {
				btn.addEventListener("click", function () {
					const target = this.getAttribute("data-target");
					const el = document.querySelector("#" + target + " code");
					if (!el) return;
					const text = el.textContent || "";
					const done = () => {
						const old = this.textContent;
						this.textContent = "已复制";
						setTimeout(() => {
							this.textContent = old;
						}, 1500);
					};
					if (navigator.clipboard && navigator.clipboard.writeText) {
						navigator.clipboard.writeText(text).then(done).catch(() => fallbackCopy(text, done));
					} else {
						fallbackCopy(text, done);
					}
				});
			});

			function fallbackCopy(text, done) {
				const ta = document.createElement("textarea");
				ta.value = text;
				ta.style.position = "fixed";
				ta.style.opacity = "0";
				document.body.appendChild(ta);
				ta.select();
				try {
					document.execCommand("copy");
					done();
				} catch (e) {
					console.error("copy failed", e);
				}
				document.body.removeChild(ta);
			}
		})();
	</script>
</MainGridLayout>
